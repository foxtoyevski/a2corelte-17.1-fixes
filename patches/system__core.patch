diff --git a/rootdir/Android.mk b/rootdir/Android.mk
index 24b3999..2813f76 100644
--- a/rootdir/Android.mk
+++ b/rootdir/Android.mk
@@ -12,7 +12,15 @@ LOCAL_REQUIRED_MODULES := fsverity_init
 
 # The init symlink must be a post install command of a file that is to TARGET_ROOT_OUT.
 # Since init.rc is required for init and satisfies that requirement, we hijack it to create the symlink.
+#
+# Non-SAR (a2corelte port): boot ramdisk'teki /init GERCEK init_first_stage binary'si
+# olmak zorundadir; kernel /system mount edilmeden once onu calistirir. Bu symlink
+# yalnizca system-as-root icin gereklidir; non-SAR'da init/Android.mk'nin kurdugu
+# gercek init binary'sinin UZERINE yazarak cihazi boot edemez hale getirir
+# (Samsung splash'te takilir). Bu yuzden yalnizca SAR'da olustur.
+ifeq ($(BOARD_BUILD_SYSTEM_ROOT_IMAGE),true)
 LOCAL_POST_INSTALL_CMD := ln -sf /system/bin/init $(TARGET_ROOT_OUT)/init
+endif
 
 include $(BUILD_PREBUILT)
 
