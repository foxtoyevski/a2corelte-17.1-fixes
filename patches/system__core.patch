     };
 
diff --git a/init/first_stage_mount.cpp b/init/first_stage_mount.cpp
index 3e76556..6f1fbbf 100644
--- a/init/first_stage_mount.cpp
+++ b/init/first_stage_mount.cpp
@@ -524,14 +524,27 @@ bool FirstStageMount::TrySwitchSystemAsRoot() {
     return true;
 }
 
+// Non-SAR cihazlarda (BOARD_BUILD_SYSTEM_ROOT_IMAGE != true) sistem image'i
+// duz (flat) olarak uretilir: /system/bin/init, image kokunde /bin/init'tir ve
+// ic ice /system dizini bulunmaz. Bu durumda SwitchRoot("/system") calisamaz:
+// (1) read-only /system uzerinde /dev, /proc, /sys gibi mount noktalari
+//     yaratilamaz, (2) pivot sonrasi /system/bin init bulunamaz.
+// Bu yuzden kok ramdisk'te kalinir, /system normal bir bolum olarak mount
+// edilir ve init /system/bin/init'i selinux_setup ile calistirir.
+#if defined(ANDROID_INIT_NON_SYSTEM_ROOT)
+constexpr bool kSystemAsRoot = false;
+#else
+constexpr bool kSystemAsRoot = true;
+#endif
+
 bool FirstStageMount::MountPartitions() {
-    if (!TrySwitchSystemAsRoot()) return false;
+    if (kSystemAsRoot && !TrySwitchSystemAsRoot()) return false;
 
     if (!SkipMountingPartitions(&fstab_)) return false;
 
     for (auto current = fstab_.begin(); current != fstab_.end();) {
-        // We've already mounted /system above.
-        if (current->mount_point == "/system") {
+        // We've already mounted /system above (system-as-root only).
+        if (kSystemAsRoot && current->mount_point == "/system") {
             ++current;
             continue;
         }
