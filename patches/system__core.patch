diff --git a/init/Android.mk b/init/Android.mk
index c4f7d34..df187f4 100644
--- a/init/Android.mk
+++ b/init/Android.mk
@@ -44,7 +44,10 @@ init_cflags += \
 # Do not build this even with mmma if we're system-as-root, otherwise it will overwrite the symlink.
 ifneq ($(BOARD_BUILD_SYSTEM_ROOT_IMAGE),true)
 include $(CLEAR_VARS)
-LOCAL_CPPFLAGS := $(init_cflags)
+# Non-SAR: duz (flat) sistem image'inda /system'e pivot edilmez, /system
+# normal bir bolum olarak mount edilir. first_stage_mount.cpp buna gore
+# TrySwitchSystemAsRoot()'i atlar.
+LOCAL_CPPFLAGS := $(init_cflags) -DANDROID_INIT_NON_SYSTEM_ROOT=1
 LOCAL_SRC_FILES := \
     devices.cpp \
     first_stage_init.cpp \
diff --git a/init/builtins.cpp b/init/builtins.cpp
index 7db851a..04043d6 100644
--- a/init/builtins.cpp
+++ b/init/builtins.cpp
@@ -1010,6 +1010,7 @@ static Result<Success> do_restorecon(const BuiltinArguments& args) {
         {"--recursive", SELINUX_ANDROID_RESTORECON_RECURSE},
         {"--skip-ce", SELINUX_ANDROID_RESTORECON_SKIPCE},
         {"--cross-filesystems", SELINUX_ANDROID_RESTORECON_CROSS_FILESYSTEMS},
+        {"--force", SELINUX_ANDROID_RESTORECON_FORCE},
