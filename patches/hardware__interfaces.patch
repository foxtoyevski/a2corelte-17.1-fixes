+// The vendor primary HAL (audio.primary.<platform>.so) on this device is a
+// prebuilt built against the Android 8.1 headers; everything else (usb,
+// r_submix, bluetooth, stub) is built from this tree with Q headers. The
+// vendor.audio.legacy81 property overrides the default decision ("1" forces
+// the 8.1 ABI view, "0" disables it) for testing.
+static bool isLegacy81Hal(const char* moduleName) {
+    bool legacy = strcmp(moduleName, AUDIO_HARDWARE_MODULE_ID_PRIMARY) == 0;
+    const std::string prop = android::base::GetProperty("vendor.audio.legacy81", "");
+    if (prop == "0") {
+        legacy = false;
+    } else if (prop == "1") {
+        legacy = true;
+    }
+    return legacy;
+}
