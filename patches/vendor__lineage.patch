diff --git a/config/common.mk b/config/common.mk
index 2cab1ea..1c15656 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -13,18 +13,14 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     ro.com.google.clientidbase=$(PRODUCT_GMS_CLIENTID_BASE)
 endif
 
-ifeq ($(TARGET_BUILD_VARIANT),eng)
-# Disable ADB authentication
+# a2corelte: bu resmi olmayan userdebug build'i ekranda onay penceresi
+# acilamadigi icin ADB kimlik dogrulamasi her zaman kapatilir. Cihaz siyah
+# ekranda kalinca "Allow USB debugging?" diyalogu gorunemedigi ic
+# unauthorized durumunda kilitleniyor ve shell/logcat alinamiyordu.
+# Not: FINAL_DEFAULT_PROPERTIES uniq-pairs-by-first-component ile
+# sadestirildigi icin deger burada verilmelidir; device.mk'ye yazilan
+# PRODUCT_SYSTEM_DEFAULT_PROPERTIES daha sonra geldigi icin yenilmiyordu.
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
-else
-ifdef WITH_ADB_INSECURE
-# Forcebly disable ADB authentication
-PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
-else
-# Enable ADB authentication
-PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=1
-endif
-endif
 
 # Backup Tool
 PRODUCT_COPY_FILES += \
