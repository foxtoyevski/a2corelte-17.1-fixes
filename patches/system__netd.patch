+    // Make sure BPF programs are loaded before doing anything. On kernels without eBPF
+    // (e.g. old Exynos 3.10), the BPF loader never publishes bpf.progs_loaded, so waiting
+    // here would hang netd forever and stall the framework (which binds netd at boot).
+    if (android::bpf::getBpfSupportLevel() != android::bpf::BpfLevel::NONE) {
+        while (!android::base::WaitForProperty("bpf.progs_loaded", "1",
+               std::chrono::seconds(5))) {
+            ALOGD("netd waited 5s for bpf.progs_loaded, still waiting...");
