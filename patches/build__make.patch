 # Base modules and settings for the vendor partition.
+#
+# NOT: "gralloc.default" bu listeden CIKARILDI (a2corelte portu).
+# Bu agac stok Exynos gralloc'unu (gralloc.exynos5.so) /vendor/lib/hw altina
+# PRODUCT_COPY_FILES ile koyuyor. gralloc.default modulu ise A10 agacinin
+# kendi gralloc'i ve Samsung private_handle_t ABI'siyle UYUMSUZ.
+# Ikisi ayni dizinde bulundugunda surecler farkli ABI ile handle uretip
+#   E : invalid gralloc handle
+#   E : GraphicBufferAllocator: Failed to allocate (1 x 1) ... : 2 (ENOENT)
+# hatasi veriyor; 1x1 piksel bile tahsis edilemedigi icin ekran bos kaliyor.
+# Tek gralloc ile kalmak sart: ro.hardware.gralloc=exynos5
+# (device/samsung/a2corelte/system.prop) KORUNMALIDIR.
 PRODUCT_PACKAGES += \
     android.hardware.cas@1.1-service \
     android.hardware.configstore@1.1-service \
@@ -45,7 +56,6 @@ PRODUCT_PACKAGES += \
     dumpsys_vendor \
     fs_config_files_nonsystem \
     fs_config_dirs_nonsystem \
-    gralloc.default \
     group \
     init_vendor \
     libbundlewrapper \
diff --git a/tools/releasetools/build_image.py b/tools/releasetools/build_image.py
