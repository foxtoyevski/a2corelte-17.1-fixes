diff --git a/core/Makefile b/core/Makefile
index f6c2463..1db622c 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -316,7 +316,7 @@ $(intermediate_system_build_prop): PRIVATE_BUILD_DESC := $(build_desc)
 # The string used to uniquely identify the combined build and product; used by the OTA server.
 ifeq (,$(strip $(BUILD_FINGERPRINT)))
   ifeq ($(strip $(HAS_BUILD_NUMBER)),false)
-    BF_BUILD_NUMBER := $(BUILD_USERNAME)$$($(DATE_FROM_FILE) +%m%d%H%M)
+    BF_BUILD_NUMBER := eng.foxtoyevski.$$($(DATE_FROM_FILE) +%Y%m%d.%H%M%S)
   else
     BF_BUILD_NUMBER := $(file <$(BUILD_NUMBER_FILE))
   endif
@@ -1532,8 +1532,14 @@ $(if $(BOARD_AVB_ENABLE),\
 $(if $(filter true,$(BOARD_USES_RECOVERY_AS_BOOT)),\
     $(hide) echo "recovery_as_boot=true" >> $(1))
 $(if $(filter true,$(BOARD_BUILD_SYSTEM_ROOT_IMAGE)),\
-    $(hide) echo "system_root_image=true" >> $(1))
-$(hide) echo "root_dir=$(TARGET_ROOT_OUT)" >> $(1)
+    $(hide) echo "system_root_image=true" >> $(1); \
+    $(hide) echo "root_dir=$(TARGET_ROOT_OUT)" >> $(1))
+# NOT: root_dir SADECE system-as-root (SAR) icin yazilmalidir. build_image.py:167
+#   root_dir = prop_dict.get("root_dir") -> if root_dir: ROOT staging'i image
+#   kokune kopyalanir ve asili SYSTEM icerigi <image>/system altina konur.
+#   Kosulsuz yazildiginda non-SAR cihazlarda sistem image'i ic ice gomulu
+#   (root: init.rc + system/: bin,app,framework...) uretilir; /system mount
+#   edildiginde /system/system olur ve init /system/build.prop bulamaz.
 $(if $(PRODUCT_USE_DYNAMIC_PARTITION_SIZE),$(hide) echo "use_dynamic_partition_size=true" >> $(1))
 $(if $(3),$(hide) $(foreach kv,$(3),echo "$(kv)" >> $(1);))
 endef
diff --git a/core/envsetup.mk b/core/envsetup.mk
index 9e722bd..1d20783 100644
--- a/core/envsetup.mk
+++ b/core/envsetup.mk
@@ -224,9 +224,20 @@ TARGET_COPY_OUT_SYSTEM_OTHER := system_other
 TARGET_COPY_OUT_DATA := data
 TARGET_COPY_OUT_ASAN := $(TARGET_COPY_OUT_DATA)/asan
 TARGET_COPY_OUT_OEM := oem
-TARGET_COPY_OUT_RAMDISK := ramdisk
 TARGET_COPY_OUT_DEBUG_RAMDISK := debug_ramdisk
 TARGET_COPY_OUT_ROOT := root
+# Non-SAR (BOARD_BUILD_SYSTEM_ROOT_IMAGE != true) icin boot ramdisk'in icerigi
+# rootdir staging dizinidir (init.rc, fstab.*, init.environ.rc, /init symlink'i
+# ve system/core/init/Android.mk'nin kurdugu gercek init_first_stage binary'si).
+# Bu yuzden TARGET_RAMDISK_OUT ile TARGET_ROOT_OUT ayni dizin olmak ZORUNDA:
+#   Makefile:932  mkbootfs $(TARGET_RAMDISK_OUT)  -> paketlenen icerik
+#   Makefile:3893 non-SAR'da target-files BOOT/RAMDISK = $(TARGET_RAMDISK_OUT)
+#   init/Android.mk:65 LOCAL_MODULE_PATH := $(TARGET_RAMDISK_OUT) (init binary)
+# Onceki deger "ramdisk" idi ve rootdir dosyalari root/ dizininde kalip
+# boot.img icinde init.rc/fstab hic girmiyordu => init "Can't open /init.rc".
+# NOT: TARGET_COPY_OUT_ROOT bir ust satirda tanimlanir; bu atamadan ONCE
+# kullanilirsa bos stringe acilir ve mkbootfs tum PRODUCT_OUT'u paketler.
+TARGET_COPY_OUT_RAMDISK := $(TARGET_COPY_OUT_ROOT)
 TARGET_COPY_OUT_RECOVERY := recovery
 # The directory used for optional partitions depend on the BoardConfig, so
 # they're defined to placeholder values here and swapped after reading the
diff --git a/core/version_defaults.mk b/core/version_defaults.mk
index 65e7f45..a6a1ab4 100644
--- a/core/version_defaults.mk
+++ b/core/version_defaults.mk
@@ -312,7 +312,7 @@ ifndef BUILD_NUMBER
   # If no BUILD_NUMBER is set, create a useful "I am an engineering build
   # from this date/time" value.  Make it start with a non-digit so that
   # anyone trying to parse it as an integer will probably get "0".
-  BUILD_NUMBER := eng.$(shell echo $${BUILD_USERNAME:0:6}).$(shell $(DATE) +%Y%m%d.%H%M%S)
+  BUILD_NUMBER := eng.foxtoyevski.$(shell $(DATE) +%Y%m%d.%H%M%S)
   HAS_BUILD_NUMBER := false
 endif
 .KATI_READONLY := BUILD_NUMBER HAS_BUILD_NUMBER
diff --git a/target/product/base_vendor.mk b/target/product/base_vendor.mk
index 584327c..12d8419 100644
