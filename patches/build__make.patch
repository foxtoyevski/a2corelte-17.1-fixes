+  # (Asagidaki SAR yolu sadece system-as-root icin kullanilmalidir; aksi halde
+  #  sistem image'i ic ice gomulu kurulur ve init sistemi bulamaz.)
+  if not prop_dict.get("system_root_image"):
+    return origin_in, fs_config
+
   # Construct a staging directory of the root file system.
   in_dir = common.MakeTempDir()
   root_dir = prop_dict.get("root_dir")
