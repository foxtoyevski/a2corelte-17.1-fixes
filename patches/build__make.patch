@@ -162,6 +162,15 @@ def SetUpInDirAndFsConfig(origin_in, prop_dict):
     prop_dict["mount_point"] = "/"
     return prop_dict["first_pass"]
 
+  # Non-SAR (prop_dict icinde system_root_image yok): A9/LOS16 davranisi.
+  # Sistem icerigi image'in KOKUNDE kalir: ROOT staging'i birlestirilmez ve
